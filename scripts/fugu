#!/bin/sh
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
for candidate in node bun /exec-daemon/node /usr/local/bin/node /usr/bin/node; do
  if command -v "$candidate" >/dev/null 2>&1; then
    exec "$candidate" "$ROOT/scripts/fugu.js" "$@"
  fi
  if [ -x "$candidate" ]; then
    exec "$candidate" "$ROOT/scripts/fugu.js" "$@"
  fi
done
echo "No hay Node ni Bun en esta VM. Prueba: command -v node; ls /exec-daemon/node" >&2
exit 127
